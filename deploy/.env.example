# App deploy env template (shared for local + remote)
# Local: use this as deploy/.env
# Remote: use this as deploy/.env
# Runtime settings (mail, storage, cors, log level, toggles, expiries) live in
# src/config/*. Only app basics, secrets, and infra vars belong in this file.
# ── App ────────────────────────────────────────────
APP_ENV=production
APP_NAME=nexgen
APP_HOST=localhost
APP_PORT=3000

# Full public URL the app is served at (used for links, redirects, CORS)
# Local: http://localhost:3000  |  Remote: https://your-domain.com
APP_URL=http://localhost:3000

# Run "db:migrate --seed" automatically on container start (true/false)
AUTO_MIGRATE=true

# UI origin (only needed when UI is on a different domain than API)
# Leave empty if UI is served from the same APP_URL or UI=false
FRONTEND_URL=http://localhost:5180

# ── Reverse Proxy (nginx-proxy) ────────────────────
# Remote only: nginx-proxy routes by VIRTUAL_HOST and auto-issues Let's Encrypt certs.
# Leave empty for local-only deploys.
VIRTUAL_HOST=
VIRTUAL_PORT=3000
LETSENCRYPT_HOST=
LETSENCRYPT_EMAIL=

# ── Database ───────────────────────────────────────
# Set the password and database name to match deploy/server/.env
DATABASE_URL=postgres://postgres:change-me-postgres@postgres-global:5432/postgres

# ── JWT Auth (expiries live in src/config/jwt.ts) ──
JWT_ACCESS_SECRET=idp_jwt_access_secret_2026_nexgen
JWT_REFRESH_SECRET=idp_jwt_refresh_secret_2026_nexgen

# ── Cookie (name lives in src/config/cookie.ts) ────
COOKIE_SECRET=idp_cookie_secret_2026_nexgen

# ── Storage credentials (driver/disk/bucket live in src/config/storage.ts) ──
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ── Mail credentials (host/port/encryption live in src/config/mail.ts) ──
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Redis ──────────────────────────────────────────
# Enables/disables cache, session, queue, events, Queue Dashboard (all Redis-backed services)
REDIS=false
REDIS_URL=redis://redis-global:6379
REDIS_PREFIX=idp

# ── Feature Toggle (build) ─────────────────────────
# Enable/disable UI build and serving. Set false for API-only mode
UI=true

# ── Feature Toggle ─────────────────────────────────
# OpenAPI / Scalar docs at /api-docs. Set true to enable.
OPEN_API=true
# Socket.IO realtime server. Set false to disable.
SOCKET=false


